{
  "expo": {
    "name": "Kantongin",
    "slug": "Kantongin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kantongin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.kantongin.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EE",
          "image": "./assets/mochi/mochi-coin.png",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/mochi/mochi-coin.png",
            "backgroundColor": "#121A16"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kantongin memakai foto pilihanmu sebagai foto profil.",
          "cameraPermission": "Kantongin memakai kamera untuk memotret struk belanja. Struk dibaca langsung di HP, tidak dikirim ke mana pun.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "19e6d83a-e5f5-422b-8b9f-191715cdf979"
      }
    },
    "owner": "khaliqakbar"
  }
}
